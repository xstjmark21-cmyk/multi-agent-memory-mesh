{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/multi-agent-memory-mesh/memory-entry.schema.json",
  "title": "Memory Entry",
  "description": "共享记忆中心里单条记忆的结构定义。Markdown 记忆档中每条记忆可用等价的 YAML front-matter 表达。",
  "type": "object",
  "required": ["id", "agent_id", "created_at", "content", "scope"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "全局唯一 ID，建议 mem_<yyyymmdd>_<序号>",
      "pattern": "^mem_[0-9]{8}_[0-9]{3,}$"
    },
    "agent_id": {
      "type": "string",
      "description": "写入者标识（来源标识，实现分档不混池与责任追溯）"
    },
    "device": {
      "type": "string",
      "description": "产生该记忆的设备代号（脱敏代号，勿写真实主机名/IP）"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "创建时间（含时区）"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "string",
      "description": "记忆正文。必须已过隐私规则：不含真实姓名、密码、密钥、订阅链接",
      "minLength": 1,
      "maxLength": 2000
    },
    "tags": {
      "type": "array",
      "description": "检索用标签，供 pull-based 检索按标签取片段",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "scope": {
      "type": "string",
      "description": "可见范围。private 永不离开本机；shared 同步到 Hub 供其他 agent 检索；public 可对外公开",
      "enum": ["private", "shared", "public"]
    },
    "confidence": {
      "type": "string",
      "description": "可信度。区分已验证事实与某 agent 的声称/猜测，防止把猜测当真理",
      "enum": ["verified", "reported", "guess"],
      "default": "reported"
    },
    "verified_by": {
      "type": "array",
      "description": "交叉校验痕迹：确认过这条记忆的其他 agent_id",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "disputed_by": {
      "type": "array",
      "description": "提出异议的 agent_id。存在异议时应在 coordination/ 建协商记录",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "string",
      "description": "本条取代的旧记忆 id，用于治理事实漂移",
      "pattern": "^mem_[0-9]{8}_[0-9]{3,}$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "过期时间。时效性信息（如临时状态）应设过期，避免陈旧记忆长期误导"
    },
    "read_allow": {
      "type": "array",
      "description": "细粒度读取白名单（Phase 2）。为空表示所有 mesh 内 agent 可读",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "examples": [
    {
      "id": "mem_20260828_001",
      "agent_id": "agent-a",
      "device": "cloud-vps",
      "created_at": "2026-08-28T18:00:00+08:00",
      "content": "反向代理走子路径时，前端需注入 base 前缀，后端 proxy_pass 需剥掉前缀",
      "tags": ["infra", "nginx"],
      "scope": "shared",
      "confidence": "verified",
      "verified_by": ["agent-b"]
    },
    {
      "id": "mem_20260828_002",
      "agent_id": "agent-a",
      "device": "cloud-vps",
      "created_at": "2026-08-28T11:20:00+08:00",
      "content": "媒体服务器局域网地址已更正（见 coordination/2026-08-28-device-address-correction.md）",
      "tags": ["media", "correction"],
      "scope": "shared",
      "confidence": "verified",
      "verified_by": ["agent-b"],
      "supersedes": "mem_20260820_004"
    }
  ]
}
